# Copy this file to .env and replace every change-me placeholder locally.
POSTGRES_DB=utto
POSTGRES_USER=utto
POSTGRES_PASSWORD=change-me-local-password
DATABASE_URL=postgresql://utto:change-me-local-password@db:5432/utto
UTTO_API_PORT=8000
# Keep 127.0.0.1 unless a physical phone on your trusted LAN needs to reach the API.
UTTO_API_BIND=127.0.0.1
# Leave empty until you want /v1/chat to call DeepSeek. Never commit the real key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional OpenAI-compatible visual model for photos, GIFs, and sampled short-video frames.
# Keep local Ollama weights in D:\utto_app\models\ollama. For a private local
# Qwen2.5-VL setup through Ollama, use:
# UTTO_VISION_BASE_URL=http://host.docker.internal:11434/v1
# UTTO_VISION_API_KEY=
# UTTO_VISION_MODEL=qwen2.5vl:3b
# Leave all three blank to disable visual analysis; text documents are still extracted locally.
UTTO_VISION_BASE_URL=
UTTO_VISION_API_KEY=
UTTO_VISION_MODEL=

# Optional local speech-to-text for audio files and video soundtracks. Keep the
# model under D:\utto_app\models\whisper and expose it to Docker as below.
# UTTO_AUDIO_MODEL=/models/whisper/models--Systran--faster-whisper-small/snapshots/<snapshot-id>
# UTTO_AUDIO_DEVICE=cpu
# UTTO_AUDIO_COMPUTE_TYPE=int8
UTTO_AUDIO_MODEL=
UTTO_AUDIO_DEVICE=cpu
UTTO_AUDIO_COMPUTE_TYPE=int8
