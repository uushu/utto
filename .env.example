# Copy this file to .env and replace every change-me placeholder locally.
POSTGRES_DB=utto
POSTGRES_USER=utto
POSTGRES_PASSWORD=change-me-local-password
DATABASE_URL=postgresql://utto:change-me-local-password@db:5432/utto
UTTO_API_PORT=8000
# Keep 127.0.0.1 unless a physical phone on your trusted LAN needs to reach the API.
UTTO_API_BIND=127.0.0.1
DEEPSEEK_API_KEY=change-me-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
